// ═══════════════════════════════════════════════════════════════════════
// M-Pesa Express Gateway — Database Schema (Prisma)
// ═══════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Merchants ──────────────────────────────────────────────────────
model Merchant {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  email               String   @unique
  phone_number        String
  mpesa_number        String
  business_name       String
  api_key_public      String   @unique @map("api_key_public")
  api_key_secret_hash String   @unique @map("api_key_secret_hash")
  webhook_secret      String
  callback_url        String
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now()) @map("created_at")
  updated_at          DateTime @updatedAt @map("updated_at")

  transactions Transaction[]

  @@map("merchants")
}

// ─── Transactions ───────────────────────────────────────────────────
model Transaction {
  id                        String   @id @default(uuid()) @db.Uuid
  merchant_id               String   @map("merchant_id") @db.Uuid
  checkout_request_id       String   @unique @map("checkout_request_id")
  amount                    Decimal  @db.Decimal(12, 2)
  phone_number              String   @map("phone_number")
  account_reference         String   @default("") @map("account_reference")
  status                    String   @default("PENDING")
  mpesa_receipt_number      String?  @map("mpesa_receipt_number")
  stk_response_description  String?  @map("stk_response_description")
  webhook_delivered         Boolean  @default(false) @map("webhook_delivered")
  webhook_attempts          Int      @default(0) @map("webhook_attempts")
  created_at                DateTime @default(now()) @map("created_at")
  updated_at                DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@index([merchant_id])
  @@index([status])
  @@index([created_at])
  @@map("transactions")
}

// ─── API Key Audit Log ─────────────────────────────────────────────
model ApiKeyLog {
  id          String   @id @default(uuid()) @db.Uuid
  merchant_id String   @map("merchant_id") @db.Uuid
  action      String   // 'created', 'rotated', 'revoked'
  ip_address  String?  @map("ip_address")
  user_agent  String?  @map("user_agent")
  created_at  DateTime @default(now()) @map("created_at")

  @@index([merchant_id])
  @@map("api_key_logs")
}

// ─── Settlement Ledger ("The Vacuum") ───────────────────────────────
// Tracks every credit and debit to the master corporate wallet.
model LedgerEntry {
  id            String   @id @default(uuid()) @db.Uuid
  tx_ref        String   @unique @map("tx_ref")           // unique reference for idempotency
  type          String                                   // CREDIT (payment received) or DEBIT (payout sent)
  amount        Decimal  @db.Decimal(12, 2)
  balance_after Decimal  @db.Decimal(12, 2) @map("balance_after")
  source        String                                   // 'STK_PUSH', 'ADMIN_CREDIT', 'B2C_PAYOUT', 'REFUND'
  description   String   @default("")
  meta          String?                                  // JSON string for extra data
  created_at    DateTime @default(now()) @map("created_at")

  @@index([type])
  @@index([source])
  @@index([created_at])
  @@map("ledger_entries")
}

// ─── Balance Snapshot ───────────────────────────────────────────────
// Single-row table tracking current vault balance.
model VaultBalance {
  id               String   @id @default(uuid()) @db.Uuid
  total_credits    Decimal  @db.Decimal(14, 2) @default(0) @map("total_credits")
  total_debits     Decimal  @db.Decimal(14, 2) @default(0) @map("total_debits")
  available        Decimal  @db.Decimal(14, 2) @default(0) @map("available")
  pending_payouts  Decimal  @db.Decimal(14, 2) @default(0) @map("pending_payouts")
  updated_at       DateTime @updatedAt @map("updated_at")

  @@map("vault_balance")
}

// ─── Payout Requests (B2C withdrawals) ─────────────────────────────
model PayoutRequest {
  id                    String   @id @default(uuid()) @db.Uuid
  idempotency_key       String   @unique @map("idempotency_key")
  amount                Decimal  @db.Decimal(12, 2)
  recipient_phone       String   @map("recipient_phone")
  status                String   @default("PENDING")  // PENDING, PROCESSING, SUCCESSFUL, FAILED, REVERSED
  command_id            String   @default("BusinessPayment") @map("command_id")
  initiator_name        String   @default("glitchitapi") @map("initiator_name")
  conversation_id       String?  @map("conversation_id")  // Safaricom B2C ConversationID
  result_code           Int?     @map("result_code")
  result_description    String?  @map("result_description")
  mpesa_receipt         String?  @map("mpesa_receipt")
  security_credential   String?  @map("security_credential")
  retry_count           Int      @default(0) @map("retry_count")
  requested_by          String?  @map("requested_by")  // admin user ID
  processed_at          DateTime? @map("processed_at")
  created_at            DateTime @default(now()) @map("created_at")
  updated_at            DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([recipient_phone])
  @@index([created_at])
  @@map("payout_requests")
}
