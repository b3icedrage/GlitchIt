{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "other",
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "public, no-cache" }]
    },
    {
      "source": "/api/chat",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
