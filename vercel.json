{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "buildCommand": "node build.js",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "public, no-cache" }]
    },
    {
      "source": "/api/chat",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "routes": [
    { "src": "/api/gateway/(.*)", "dest": "/api/gateway.js" },
    { "src": "/api/payment/(.*)", "dest": "/api/payment.js" },
    { "src": "/v1/(.*)", "dest": "/api/gateway.js" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
