  "appName": "GlitchIt",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "allowNavigation": ["glitchit.app", "*.glitchit.app", "socaxjkikrxantwxacqy.supabase.co"]
  },
  "android": {
    "backgroundColor": "#000000",
    "buildOptions": {
      "keystorePath": "app/release.keystore",
